{
  "name": "blockmedshare-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:patient": "npm run dev -w @blockmedshare/patient-portal",
    "dev:hospital": "npm run dev -w @blockmedshare/hospital-portal",
